[user]
	name = tamizrj
	email = tamizrj@gmail.com
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = false
[help]
	autocorrect = prompt
[core]
	editor = nvim
	excludesfile = ~/.config/git/.global_gitignore

# if "uni" in the path at all, use uni credentials
[includeIf "gitdir/i:**/uni/**"]
    path = ~/.config/git/config-uni

[pretty]
	twoline = format:%C(auto)%h%C(reset) %C(white)-%C(reset) %C(italic blue)%ad%C(reset) %C(italic cyan)(%ar)%C(reset)%C(auto)%d%C(reset)%n %C(white)⤷%C(reset) %s %C(241)- %an <%aE>%C(reset)%n%w(0,7,7)%+(trailers:only,unfold)

[alias]
	graph = "log --color --graph --all --pretty=twoline"
