#!/bin/dash
# should be POSIX standard (compatible with bash and zsh)
# not to be run interactively

alias df='/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME'
alias cse="ssh z5592097@login7.cse.unsw.edu.au"
alias myclang++="clang++ -std=c++23"

mygpp() {
    # just uses a.out
    local args="-std=c++23 -Wall -Wextra -fsanitize=address,undefined -g"
    echo "g++ $args $1"
    # aliased to clang++ on macOS
    g++ "$args" "$1"
}


if [ -f "$HOME/.localrc" ]; then
    . "$HOME/.localrc"
fi

