# Ghostty configuration file
# checks all candidates for fish path
command = /bin/sh -c "exec $(command -v /opt/homebrew/bin/fish /home/linuxbrew/.linuxbrew/bin/fish /usr/bin/fish fish 2>/dev/null | head -n1) --login --interactive"
font-family = JetBrainsMono Nerd Font
shell-integration-features = ssh-terminfo,ssh-env
theme = Atom One Dark
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
