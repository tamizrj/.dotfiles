#!/bin/bash

# 1. Exit immediately if not running interactively
case $- in
    *i*) ;;
      *) return;;
esac

# 2. History Settings
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000

# 3. Update window size after each command
shopt -s checkwinsize

# 4. Standard Colored Prompt
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# 5. Enable programmable bash completions
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# ========================= MY STUFF ==========================

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias c="clear"
alias myclang++="clang++ -std=c++23"
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'

mygpp() {
    # just uses a.out
    local args="-std=c++23 -Wall -Wextra -fsanitize=address,undefined -g"
    echo "g++ $args $1"
    # aliased to clang++ on macOS
    g++ $args "$1"
}


if [ -f "$HOME/.localrc" ]; then
    . "$HOME/.localrc"
fi

